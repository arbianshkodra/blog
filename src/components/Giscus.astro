<!--
  GISCUS COMMENTS — NOT YET CONFIGURED FOR THIS BLOG.
  The data-repo / data-repo-id / data-category-id below still point at the
  theme author's repo (trevortylerlee/astro-micro). Until you replace them,
  comments will NOT post to arbianshkodra/blog.

  To make it work:
    1. Enable GitHub Discussions on arbianshkodra/blog
       (repo Settings -> General -> Features -> Discussions).
    2. Go to https://giscus.app, enter arbianshkodra/blog, pick a category
       (e.g. Announcements).
    3. Copy the generated data-repo-id and data-category-id and replace the
       three TODO values below.
  Repo is public, so Giscus will work once these are set.
-->
<div class="giscus"></div>

<script
  is:inline
  data-astro-rerun
  src="https://giscus.app/client.js"
  data-repo="arbianshkodra/blog"
  data-repo-id="TODO_REPO_ID_FROM_GISCUS_APP"
  data-category="Announcements"
  data-category-id="TODO_CATEGORY_ID_FROM_GISCUS_APP"
  data-mapping="pathname"
  data-strict="0"
  data-reactions-enabled="1"
  data-emit-metadata="0"
  data-input-position="top"
  data-theme="preferred_color_scheme"
  data-lang="en"
  data-loading="lazy"
  crossorigin="anonymous"
  async></script>
