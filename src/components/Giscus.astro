<!--
  GISCUS COMMENTS — configured for arbianshkodra/blog.
  Comments are stored as GitHub Discussions in the "Announcements" category.
  Mapping is by pathname, so each post gets its own discussion thread.

  Requires the Giscus GitHub App to be installed on the repo with access to
  arbianshkodra/blog: https://github.com/apps/giscus
  (Discussions is already enabled; repo + category IDs below are real.)
-->
<div class="giscus"></div>

<script
  is:inline
  data-astro-rerun
  src="https://giscus.app/client.js"
  data-repo="arbianshkodra/blog"
  data-repo-id="R_kgDOTiEAbg"
  data-category="Announcements"
  data-category-id="DIC_kwDOTiEAbs4DB4I7"
  data-mapping="pathname"
  data-strict="0"
  data-reactions-enabled="1"
  data-emit-metadata="0"
  data-input-position="top"
  data-theme="dark"
  data-lang="en"
  data-loading="lazy"
  crossorigin="anonymous"
  async></script>
