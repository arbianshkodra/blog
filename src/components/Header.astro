---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
---

<header transition:persist>
  <Container>
    <div class="flex flex-wrap justify-between gap-y-2">
      <Link href="/" underline={false}>
        <div class="font-semibold">
          <span class="text-term-green-dim">arbian@shkodra</span>
          <span class="text-neutral-500">:</span>
          <span class="text-sky-500 dark:text-sky-400">~</span>
          <span class="text-neutral-500">$</span>
        </div>
      </Link>
      <nav class="flex items-center gap-1 text-sm">
        <span class="text-neutral-500">cd</span>
        <Link href="/blog">blog</Link>
        <span class="text-neutral-500">|</span>
        <Link href="/projects">projects</Link>
        <span class="text-neutral-500">|</span>
        <button
          id="magnifying-glass"
          aria-label="Search"
          class="flex items-center rounded-sm border border-neutral-300 bg-neutral-100 px-2 py-1 text-xs transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-neutral-700 dark:bg-neutral-900 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white"
        >
          <span class="text-neutral-500">/</span>&nbsp;grep
        </button>
      </nav>
    </div>
  </Container>
</header>
